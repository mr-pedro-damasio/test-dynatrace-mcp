# Copy this file to .env and fill in the values.
# Never commit .env to version control (.gitignore already excludes .env*).
#
# These variables are consumed by the Dynatrace MCP server declared in .mcp.json,
# which expands ${VAR} from the environment.
#
# In this devcontainer these vars are loaded automatically: .devcontainer/post-create.sh
# adds a snippet to ~/.bashrc that runs `set -a; source .env; set +a` in every new
# shell (only if .env exists). So after `cp .env.example .env`, just open a NEW terminal
# and launch `claude` — no manual sourcing needed.
#
# To load them into your CURRENT shell without opening a new one (or outside the
# devcontainer), run it by hand before launching Claude:
#
#     set -a; source .env; set +a; claude
#
# (`set -a` exports every variable defined while sourcing so the MCP server
#  subprocess inherits them; `set +a` restores normal behavior afterwards.)

# ---------------------------------------------------------------------------
# Required — Dynatrace Platform (Grail) environment URL
# ---------------------------------------------------------------------------
# Use the Platform URL (apps.dynatrace.com), NOT a classic URL (live.dynatrace.com).
# Format: https://<envid>.apps.dynatrace.com
DT_ENVIRONMENT=https://<envid>.apps.dynatrace.com

# ---------------------------------------------------------------------------
# Authentication — choose ONE of the two options below
# ---------------------------------------------------------------------------

# Option A (simplest): Platform token
# Create under Settings > Platform tokens. Grant read-only scopes to start.
# Format: dt0s16.SAMPLE.abcd1234
DT_PLATFORM_TOKEN=

# Option B: OAuth client (leave DT_PLATFORM_TOKEN blank if you use this)
# Format: OAUTH_CLIENT_ID=dt0s02.SAMPLE  /  OAUTH_CLIENT_SECRET=dt0s02.SAMPLE.abcd1234
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Container / headless settings
# ---------------------------------------------------------------------------
# Persist tokens to a file instead of the OS keychain (required in this
# devcontainer — no keychain available). Tokens are stored in ~/.config/dynatrace-mcp/.
DT_MCP_TOKEN_STORAGE=file

# ---------------------------------------------------------------------------
# Optional — cost guardrail
# ---------------------------------------------------------------------------
# Budget limit in GB for Grail query bytes scanned per session (default: 1000).
# Lower it to fail fast on unbounded scans while exploring.
# DT_GRAIL_QUERY_BUDGET_GB=10
